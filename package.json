{
  "name": "good.tools-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22",
    "bun": ">=1.2"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@good-tools/web",
    "build": "turbo run build",
    "check": "biome ci . && turbo run typecheck test",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome lint .",
    "format": "biome check --write .",
    "preview": "turbo run preview --filter=@good-tools/web"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "turbo": "^2.11.7"
  }
}
