  "scripts": {
    "dev": "vite",
    "dev:remote": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "preview:remote": "vite --host 0.0.0.0 preview",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "build-sitemap": "npx tsx src/sitemap.ts",
    "fix:prettier": "prettier \"src/**/*.{js,ts,jsx,tsx}\" --write"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
