# API Configuration (for online tools)
VITE_INTERNET_TOOLS_URL=https://internet-tools.fly.dev
VITE_IMAGE_BROWSER_URL=https://image-browser.fly.dev

# Telemetry (for CI builds - set your production values here)
VITE_ENABLE_TELEMETRY=true
VITE_GA_TRACKING_ID=G-XX2FY53B5V

# Online tools (always enabled for CI builds)
VITE_DISABLE_ONLINE_TOOLS=false

# ---------------------------------------------
# Docker Runtime Environment Variables
# (set when running container, overrides above)
# ---------------------------------------------
# PORT=80                                          # Port to serve on
# ENABLE_TELEMETRY=true                            # Enable Google Analytics
# GA_TRACKING_ID=G-XXXXXXX                         # Your GA4 tracking ID
# DISABLE_ONLINE_TOOLS=false                       # Hide tools requiring external APIs
# INTERNET_TOOLS_URL=https://internet-tools.fly.dev  # Internet tools API URL
# IMAGE_BROWSER_URL=https://image-browser.fly.dev    # Docker image browser API URL
