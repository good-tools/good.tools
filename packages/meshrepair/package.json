{
  "name": "@goodtools/meshrepair",
  "version": "0.1.1",
  "description": "WebAssembly-powered STL mesh repair using VCGlib",
  "type": "module",
  "source": "src/index.ts",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./wasm": "./dist/meshrepair.js",
    "./dist/meshrepair.js": "./dist/meshrepair.js",
    "./dist/meshrepair.wasm": "./dist/meshrepair.wasm"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build:emscripten": "docker run -it --rm -v $(pwd):/src goodtools/meshrepair-builder:latest ./build-lib.sh",
    "build:emscripten-local": "./build-lib.sh",
    "build:builder": "docker build -t goodtools/meshrepair-builder . -f docker/build.Dockerfile",
    "build": "vite build && npm run copy-assets",
    "copy-assets": "cp built/bin/meshrepair.* dist/",
    "lint": "eslint src/ --fix",
    "fix:prettier": "prettier \"src/**/*.ts\" --write",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "preview": "vite preview",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build && changeset publish"
  },
  "keywords": [
    "stl",
    "mesh",
    "repair",
    "3d-printing",
    "wasm",
    "vcglib",
    "meshlab",
    "webassembly"
  ],
  "homepage": "https://github.com/good-tools/meshrepair",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/good-tools/meshrepair.git"
  },
  "license": "GPL-3.0",
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.0",
    "@changesets/cli": "^2.27.0",
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^3.0.5",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.2",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.7",
    "vite-plugin-dts": "^4.3.0",
    "vite-plugin-static-copy": "^2.1.0",
    "vitest": "^3.0.5"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}