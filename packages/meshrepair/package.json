{
  "name": "@goodtools/trigasm",
  "version": "0.1.0",
  "description": "WebAssembly-powered STL mesh repair using VCGlib",
  "source": "src/index.ts",
  "main": "dist/main.js",
  "module": "dist/module.js",
  "types": "dist/types.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "parcel watch",
    "build:emscripten": "docker run -it --rm -v $(pwd):/src goodtools/trigasm-builder:latest ./build-lib.sh",
    "build:emscripten-local": "./build-lib.sh",
    "build": "parcel build && npm run copy-assets",
    "copy-assets": "cp built/bin/trigasm.* dist/",
    "lint": "eslint src/ --fix",
    "fix:prettier": "prettier \"src/**/*.ts\" --write",
    "test": "jest --coverage"
  },
  "keywords": [
    "stl",
    "mesh",
    "repair",
    "3d-printing",
    "wasm",
    "vcglib",
    "meshlab",
    "webassembly"
  ],
  "homepage": "https://github.com/good-tools/trigasm",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/good-tools/trigasm.git"
  },
  "license": "GPL-3.0",
  "devDependencies": {
    "@parcel/packager-ts": "^2.8.2",
    "@parcel/transformer-typescript-types": "^2.8.2",
    "@types/jest": "^29.2.5",
    "@types/node": "^18.11.18",
    "@typescript-eslint/eslint-plugin": "^5.48.1",
    "@typescript-eslint/parser": "^5.48.1",
    "eslint": "^8.31.0",
    "eslint-config-prettier": "^8.6.0",
    "eslint-plugin-prettier": "^4.2.1",
    "jest": "^29.3.1",
    "parcel": "^2.8.2",
    "prettier": "^2.8.2",
    "ts-jest": "^29.0.3",
    "typescript": "^5.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "coveragePathIgnorePatterns": [
      "<rootDir>/built/bin"
    ]
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
