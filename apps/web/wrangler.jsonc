// good.tools on Cloudflare Workers (static assets only). Deployed by .github/workflows/release.yml.
// Response headers: public/_headers.
{
  "name": "good-tools",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "good.tools", "custom_domain": true }],
  // Branch previews (.github/workflows/ci.yml) at <alias>-good-tools.<account>.workers.dev;
  // production is only served on good.tools
  "workers_dev": false,
  "preview_urls": true
}
